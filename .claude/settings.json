{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__chrome-mcp",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(sleep:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebFetch(domain:marcosperesimoveis.com.br)"
    ],
    "deny": [
      "Bash(npm update:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(npm uninstall -g:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/aprendizado.mjs listar",
            "timeout": 15,
            "statusMessage": "Lendo o caderno de aprendizados..."
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
