{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__chrome-mcp",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(sleep:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebFetch(domain:marcosperesimoveis.com.br)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/aprendizado.mjs listar",
            "timeout": 15,
            "statusMessage": "Lendo o caderno de aprendizados..."
          }
        ]
      }
    ]
  }
}
